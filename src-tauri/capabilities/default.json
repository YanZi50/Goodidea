        { "url": "https://60s.viki.moe/*" },
        { "url": "https://api.vvhan.com/*" },
        { "url": "https://api.pearktrue.cn/*" },
        { "url": "https://api.oioweb.cn/*" },
        { "url": "https://api-hot.imsyy.top/*" },
        { "url": "https://dailyhotapi.com/*" }
      ],
      "deny": []
    }
  ]
}
